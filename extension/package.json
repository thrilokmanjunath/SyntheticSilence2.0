{
  "name": "syntheticsilence2-extension",
  "version": "1.0.0",
  "description": "Chrome Extension for SyntheticSilence2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "e2e": "tsc && node e2e/chrome-e2e.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "test": "npm run check:api && tsc && node --test test/features.test.mjs test/present.test.mjs test/stream.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.0.0"
  }
}
