# Copy to .env (git-ignored) and fill in. Never commit real keys.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Free key from https://openalex.org (optional but recommended).
OPENALEX_API_KEY=

# Environment mode ('production' or 'development')
ENVIRONMENT=production

# Optional overrides
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash
# SS_VERDICT_MODE=stance            # stance (per-source) | pooled (v1: one NLI score over pooled sources)
# SS_RETRIEVERS=wikipedia,openalex  # any of: wikipedia, openalex
# SS_RANK_EVIDENCE=on               # default: on in stance mode, off in pooled mode
# SS_MAX_CLAIMS=6
# SS_CACHE=on                       # on-disk cache of finished claim results (backend/.cache, git-ignored)
# SS_CACHE_TTL_HOURS=168
# SS_CACHE_MAX_ENTRIES=500
# SS_REFERENCE_MANIFOLD=../data/manifolds/fever_train_v1.npy
