# Enforce consistent line endings across platforms (Windows / macOS / Linux)
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.cff text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows-specific scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts (no line ending normalization)
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.pptx binary
*.ico binary
*.zip binary
