# Synthetic Silence 2.0 — Production Environment Template
# Copy this file to .env.local or configure these variables in Vercel Project Settings.
# NEVER commit real API keys or secrets to version control.

# ==============================================================================
# Model Provider Credentials (Optional on server if using client ephemeral dialog)
# ==============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# External Scholarly Corpus Retrieval (Optional)
# ==============================================================================
# Free key from https://openalex.org for higher rate limits
OPENALEX_API_KEY=

# ==============================================================================
# Application Security & Environment Controls
# ==============================================================================
# Set to 'production' to disable Swagger/ReDoc docs and enforce HSTS
ENVIRONMENT=production

# Comma-separated list of additional allowed origins for CORS (e.g. custom domain, Vercel preview)
ALLOWED_ORIGINS=https://syntheticsilence.vercel.app

# ==============================================================================
# Verification Engine Tuning
# ==============================================================================
SS_VERDICT_MODE=pooled
SS_RETRIEVERS=wikipedia,openalex
SS_MAX_CLAIMS=6
SS_CACHE=on
SS_CACHE_TTL_HOURS=168
SS_CACHE_MAX_ENTRIES=500
